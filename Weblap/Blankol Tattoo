<link rel="preconnect" href="[fonts.googleapis.com](https://fonts.googleapis.com)">
<link rel="preconnect" href="[fonts.gstatic.com](https://fonts.gstatic.com)" crossorigin>
<link
href="[fonts.googleapis.com](https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:wght@300;400;500;600;700&display=swap)"
rel="stylesheet"
>

<!-- Közösségi ikonok -->
<link
rel="stylesheet"
href="[cdnjs.cloudflare.com](https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css)"
>

<style>
:root {
--background: #0c0c0c;
--surface: #151515;
--surface-light: #1d1d1d;
--text: #f4f1ea;
--muted: #b9b5ad;
--accent: #b68a52;
--accent-light: #d7b27c;
--border: rgba(255, 255, 255, 0.1);
--header-height: 76px;
--container: 1180px;
}

* {
box-sizing: border-box;
margin: 0;
padding: 0;
}

html {
scroll-behavior: smooth;
scroll-padding-top: var(--header-height);
}

body {
font-family: "Montserrat", sans-serif;
color: var(--text);
background: var(--background);
line-height: 1.7;
overflow-x: hidden;
}

body.menu-open {
overflow: hidden;
}

img {
display: block;
width: 100%;
}

a {
color: inherit;
text-decoration: none;
}

button,
input,
textarea,
select {
font: inherit;
}

.container {
width: min(90%, var(--container));
margin: 0 auto;
}

.section {
padding: 105px 0;
}

.section-dark {
background: var(--surface);
}

.section-header {
max-width: 700px;
margin-bottom: 48px;
}

.section-header.center {
margin-right: auto;
margin-left: auto;
text-align: center;
}

.eyebrow {
display: inline-block;
margin-bottom: 10px;
color: var(--accent-light);
font-size: 0.76rem;
font-weight: 700;
letter-spacing: 0.22em;
text-transform: uppercase;
}

h1,
h2,
h3 {
font-family: "Bebas Neue", sans-serif;
font-weight: 400;
letter-spacing: 0.04em;
line-height: 1;
}

h1 {
max-width: 850px;
margin-bottom: 22px;
font-size: clamp(4.2rem, 11vw, 9rem);
}

h2 {
margin-bottom: 16px;
font-size: clamp(3rem, 7vw, 5.5rem);
}

h3 {
font-size: 1.8rem;
}

p {
color: var(--muted);
}

.button {
display: inline-flex;
align-items: center;
justify-content: center;
min-height: 52px;
padding: 0 28px;
border: 1px solid var(--accent);
color: #111;
background: var(--accent);
font-weight: 700;
letter-spacing: 0.05em;
text-transform: uppercase;
cursor: pointer;
transition: 0.25s ease;
}

.button:hover {
color: var(--text);
background: transparent;
transform: translateY(-2px);
}

.button-outline {
color: var(--text);
background: transparent;
}

.button-outline:hover {
color: #111;
background: var(--accent);
}

/* Fejléc */

.site-header {
position: fixed;
z-index: 1000;
top: 0;
right: 0;
left: 0;
min-height: var(--header-height);
border-bottom: 1px solid var(--border);
background: rgba(9, 9, 9, 0.9);
backdrop-filter: blur(14px);
}

.navbar {
display: flex;
align-items: center;
justify-content: space-between;
min-height: var(--header-height);
gap: 24px;
}

.logo {
flex-shrink: 0;
font-family: "Bebas Neue", sans-serif;
font-size: 2rem;
letter-spacing: 0.09em;
}

.logo span {
color: var(--accent);
}

.nav-wrapper {
display: flex;
align-items: center;
gap: 34px;
}

.nav-links {
display: flex;
align-items: center;
gap: 25px;
list-style: none;
}

.nav-links a {
position: relative;
font-size: 0.82rem;
font-weight: 600;
letter-spacing: 0.08em;
text-transform: uppercase;
}

.nav-links a::after {
position: absolute;
right: 0;
bottom: -8px;
left: 0;
height: 1px;
background: var(--accent);
content: "";
transform: scaleX(0);
transition: transform 0.25s ease;
}

.nav-links a:hover::after,
.nav-links a.active::after {
transform: scaleX(1);
}

.social-links {
display: flex;
align-items: center;
gap: 10px;
}

.social-links a {
display: grid;
width: 35px;
height: 35px;
border: 1px solid var(--border);
border-radius: 50%;
place-items: center;
transition: 0.25s ease;
}

.social-links a:hover {
border-color: var(--accent);
color: #111;
background: var(--accent);
transform: translateY(-2px);
}

.menu-button {
display: none;
border: 0;
color: var(--text);
background: transparent;
font-size: 1.5rem;
cursor: pointer;
}

/* Kezdő szakasz */

.hero {
position: relative;
display: grid;
min-height: 100vh;
padding-top: var(--header-height);
background:
linear-gradient(90deg, rgba(0, 0, 0, 0.94) 0%, rgba(0, 0, 0, 0.68) 52%, rgba(0, 0, 0, 0.25) 100%),
url("images/hero.jpg") center / cover no-repeat;
isolation: isolate;
place-items: center;
}

.hero::after {
position: absolute;
z-index: -1;
inset: 0;
background: linear-gradient(0deg, var(--background) 0%, transparent 30%);
content: "";
}

.hero-content {
width: min(90%, var(--container));
padding: 80px 0;
}

.hero-text {
max-width: 800px;
}

.hero h1 span {
color: var(--accent);
}

.hero-description {
max-width: 650px;
margin-bottom: 32px;
color: #d0cdc7;
font-size: 1.05rem;
}

.hero-buttons {
display: flex;
flex-wrap: wrap;
gap: 14px;
}

/* Rólam */

.about-grid {
display: grid;
grid-template-columns: 0.9fr 1.1fr;
align-items: center;
gap: 70px;
}

.about-image {
position: relative;
}

.about-image::before {
position: absolute;
z-index: -1;
top: 22px;
right: -22px;
width: 100%;
height: 100%;
border: 1px solid var(--accent);
content: "";
}

.about-image img {
height: 620px;
object-fit: cover;
filter: grayscale(25%);
}

.about-content p + p {
margin-top: 18px;
}

.features {
display: grid;
grid-template-columns: repeat(3, 1fr);
gap: 16px;
margin-top: 35px;
}

.feature {
padding: 22px 15px;
border: 1px solid var(--border);
text-align: center;
}

.feature i {
display: block;
margin-bottom: 12px;
color: var(--accent);
font-size: 1.5rem;
}

.feature strong {
display: block;
font-size: 0.85rem;
}

/* Galéria */

.gallery {
display: grid;
grid-template-columns: repeat(3, 1fr);
gap: 14px;
}

.gallery-item {
position: relative;
min-height: 380px;
overflow: hidden;
cursor: pointer;
}

.gallery-item:nth-child(1),
.gallery-item:nth-child(5) {
grid-row: span 2;
}

.gallery-item img {
height: 100%;
object-fit: cover;
filter: grayscale(35%);
transition: 0.45s ease;
}

.gallery-overlay {
position: absolute;
right: 0;
bottom: 0;
left: 0;
padding: 25px;
background: linear-gradient(transparent, rgba(0, 0, 0, 0.9));
opacity: 0;
transform: translateY(15px);
transition: 0.3s ease;
}

.gallery-item:hover img {
filter: grayscale(0%);
transform: scale(1.05);
}

.gallery-item:hover .gallery-overlay {
opacity: 1;
transform: translateY(0);
}

.gallery-overlay p {
color: #d6d2ca;
font-size: 0.85rem;
}

/* Árlista */

.price-grid {
display: grid;
grid-template-columns: repeat(3, 1fr);
gap: 22px;
}

.price-card {
position: relative;
padding: 38px 30px;
border: 1px solid var(--border);
background: var(--surface-light);
transition: 0.3s ease;
}

.price-card:hover {
border-color: var(--accent);
transform: translateY(-7px);
}

.price-card.featured {
border-color: var(--accent);
}

.price-label {
position: absolute;
top: 0;
right: 0;
padding: 7px 12px;
color: #111;
background: var(--accent);
font-size: 0.68rem;
font-weight: 700;
letter-spacing: 0.08em;
text-transform: uppercase;
}

.price {
margin: 22px 0;
color: var(--accent-light);
font-family: "Bebas Neue", sans-serif;
font-size: 2.8rem;
}

.price-card ul {
display: grid;
gap: 12px;
margin: 25px 0 30px;
list-style: none;
}

.price-card li {
color: var(--muted);
font-size: 0.9rem;
}

.price-card li i {
margin-right: 9px;
color: var(--accent);
}

.price-note {
max-width: 800px;
margin: 34px auto 0;
text-align: center;
font-size: 0.88rem;
}

/* Kapcsolat */

.contact-grid {
display: grid;
grid-template-columns: 0.85fr 1.15fr;
gap: 70px;
}

.contact-list {
display: grid;
gap: 25px;
margin-top: 35px;
}

.contact-item {
display: flex;
align-items: flex-start;
gap: 16px;
}

.contact-item i {
display: grid;
flex-shrink: 0;
width: 44px;
height: 44px;
border: 1px solid var(--accent);
color: var(--accent);
place-items: center;
}

.contact-item strong {
display: block;
margin-bottom: 3px;
}

.contact-item a,
.contact-item span {
color: var(--muted);
font-size: 0.92rem;
}

.contact-item a:hover {
color: var(--accent-light);
}

.contact-form {
padding: 35px;
border: 1px solid var(--border);
background: var(--surface);
}

.form-row {
display: grid;
grid-template-columns: 1fr 1fr;
gap: 18px;
}

.form-group {
margin-bottom: 18px;
}

label {
display: block;
margin-bottom: 8px;
font-size: 0.8rem;
font-weight: 600;
text-transform: uppercase;
}

input,
textarea,
select {
width: 100%;
border: 1px solid var(--border);
outline: none;
color: var(--text);
background: #0e0e0e;
}

input,
select {
height: 50px;
padding: 0 14px;
}

textarea {
min-height: 145px;
padding: 14px;
resize: vertical;
}

input:focus,
textarea:focus,
select:focus {
border-color: var(--accent);
}

select option {
background: #111;
}

.form-message {
min-height: 24px;
margin-top: 14px;
color: var(--accent-light);
font-size: 0.87rem;
}

/* Lábléc */

footer {
padding: 40px 0;
border-top: 1px solid var(--border);
}

.footer-content {
display: flex;
align-items: center;
justify-content: space-between;
gap: 25px;
}

.footer-content p {
font-size: 0.82rem;
}

/* Nagyított galériakép */

.lightbox {
position: fixed;
z-index: 2000;
inset: 0;
display: none;
align-items: center;
justify-content: center;
padding: 35px;
background: rgba(0, 0, 0, 0.94);
}

.lightbox.open {
display: flex;
}

.lightbox img {
width: auto;
max-width: 92vw;
max-height: 88vh;
object-fit: contain;
}

.lightbox-close {
position: absolute;
top: 25px;
right: 30px;
border: 0;
color: white;
background: transparent;
font-size: 2rem;
cursor: pointer;
}

/* Mobilnézet */

@media (max-width: 960px) {
.menu-button {
display: block;
}

.nav-wrapper {
position: fixed;
top: var(--header-height);
right: -100%;
bottom: 0;
width: min(82%, 360px);
flex-direction: column;
align-items: flex-start;
padding: 40px 30px;
background: #101010;
transition: right 0.3s ease;
}

.nav-wrapper.open {
right: 0;
}

.nav-links {
width: 100%;
flex-direction: column;
align-items: flex-start;
gap: 0;
}

.nav-links li,
.nav-links a {
width: 100%;
}

.nav-links a {
display: block;
padding: 15px 0;
border-bottom: 1px solid var(--border);
}

.nav-links a::after {
display: none;
}

.social-links {
margin-top: 10px;
}

.about-grid,
.contact-grid {
grid-template-columns: 1fr;
gap: 50px;
}

.about-image {
max-width: 650px;
}

.gallery,
.price-grid {
grid-template-columns: repeat(2, 1fr);
}

.gallery-item:nth-child(n) {
grid-row: auto;
}
}

@media (max-width: 650px) {
.section {
padding: 78px 0;
}

.hero {
min-height: 92vh;
background-position: 62% center;
}

.hero-content {
padding: 55px 0;
}

.hero-buttons .button {
width: 100%;
}

.about-image img {
height: 470px;
}

.about-image::before {
top: 12px;
right: -12px;
}

.features,
.gallery,
.price-grid,
.form-row {
grid-template-columns: 1fr;
}

.gallery-item {
min-height: 430px;
}

.gallery-overlay {
opacity: 1;
transform: none;
}

.contact-form {
padding: 24px 18px;
}

.footer-content {
flex-direction: column;
text-align: center;
}
}
</style>
</head>

